# Application Settings
APP_NAME=Google CRM Integration
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8080
DEBUG=True
SECRET_KEY=your-secret-key-change-this-in-production

# Google Cloud Configuration
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8080/auth/google/callback

# Google Ads API
GOOGLE_ADS_DEVELOPER_TOKEN=your-ads-developer-token
GOOGLE_ADS_CLIENT_ID=your-ads-client-id
GOOGLE_ADS_CLIENT_SECRET=your-ads-client-secret
GOOGLE_ADS_REFRESH_TOKEN=your-ads-refresh-token
GOOGLE_ADS_LOGIN_CUSTOMER_ID=your-customer-id

# Google Analytics API
GOOGLE_ANALYTICS_PROPERTY_ID=your-property-id

# Couchbase Cloud
COUCHBASE_CONNECTION_STRING=couchbases://your-cluster.cloud.couchbase.com
COUCHBASE_USERNAME=your-username
COUCHBASE_PASSWORD=your-password
COUCHBASE_BUCKET_NAME=crm-data
COUCHBASE_SCOPE_NAME=crm
COUCHBASE_COLLECTION_LEADS=leads
COUCHBASE_COLLECTION_INSIGHTS=insights
COUCHBASE_COLLECTION_USERS=users

# Confluent Kafka (Cloud)
KAFKA_BOOTSTRAP_SERVERS=your-cluster.confluent.cloud:9092
KAFKA_SASL_USERNAME=your-api-key
KAFKA_SASL_PASSWORD=your-api-secret
KAFKA_SECURITY_PROTOCOL=SASL_SSL
KAFKA_SASL_MECHANISM=PLAIN
KAFKA_TOPIC_LEADS=crm.leads
KAFKA_TOPIC_INSIGHTS=crm.insights
KAFKA_TOPIC_EVENTS=crm.events

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_TTL=3600

# Celery
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Sync Settings
SYNC_INTERVAL_MINUTES=15
SYNC_DAYS_LOOKBACK=30
